# OKX API Configuration
# Get these from your OKX account: https://www.okx.com/account/my-api
OKX__ApiKey=your-api-key-here
OKX__SecretKey=your-secret-key-here
OKX__Passphrase=your-passphrase-here

# Environment: 'demo' for testnet, 'live' for production
OKX__Environment=demo

# Trading instrument (cryptocurrency pair)
OKX__InstrumentId=SOL-USDT

# Strategy Configuration
Strategy__RiskPercentage=1.0
Strategy__MaxPositions=1
Strategy__RSIPeriod=2
Strategy__VWAPPeriod=20
Strategy__ATRPeriod=14
Strategy__StopLossATRMultiplier=2.0
Strategy__TakeProfitATRMultiplier=3.0

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# Logging Configuration
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information

# Optional: Database connection (if using database for trade history)
# ConnectionStrings__DefaultConnection=your-database-connection-string

# Optional: Telegram notifications (if implemented)
# Telegram__BotToken=your-telegram-bot-token
# Telegram__ChatId=your-chat-id

# Optional: Discord webhooks (if implemented)
# Discord__WebhookUrl=your-discord-webhook-url